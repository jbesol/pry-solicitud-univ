# Copie este archivo como backend/.env y ajuste los valores.

# Base de datos relacional. Sin esta variable se usa SQLite local (solicitudes.db).
# PostgreSQL local:  postgresql+psycopg2://postgres:postgres@localhost:5432/solicitudes
DATABASE_URL=sqlite:///./solicitudes.db

# Genere una clave con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambie-esta-clave
ACCESS_TOKEN_EXPIRE_MINUTES=120

# development | production (en production se exige JWT_SECRET_KEY propia)
ENVIRONMENT=development

# Orígenes permitidos para el frontend en desarrollo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Crear usuarios y solicitudes de demostración si la BD está vacía
SEED_DEMO=true

# Correo opcional (además active el parámetro NOTIFICAR_CORREO=true desde el panel de administración)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@universidad.edu.co
